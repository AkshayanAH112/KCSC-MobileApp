{
  "projectId": "ee929640-df2f-40ae-be59-5812e5982f8e",
  "shape": "package",
  "pkg": "lakshan-mobile",
  "globalName": "LakshanDS",
  "buildCmd": "npx @tailwindcss/cli -i .design-sync/ds-styles.css -o .design-sync/.cache/ds-tailwind.css",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".design-sync/.cache/ds-tailwind.css",
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Dialog": { "cardMode": "single", "viewport": "520x540" },
    "Sheet": { "cardMode": "single", "viewport": "480x460" },
    "DropdownMenu": { "cardMode": "single", "viewport": "400x360" },
    "Tooltip": { "cardMode": "single", "viewport": "340x200" }
  },
  "componentSrcMap": {
    "badgeVariants": null,
    "buttonVariants": null,
    "Avatar": "src/components/ui/avatar.tsx",
    "Badge": "src/components/ui/badge.tsx",
    "Button": "src/components/ui/button.tsx",
    "Card": "src/components/ui/card.tsx",
    "Collapsible": "src/components/ui/collapsible.tsx",
    "Dialog": "src/components/ui/dialog.tsx",
    "DropdownMenu": "src/components/ui/dropdown-menu.tsx",
    "Input": "src/components/ui/input.tsx",
    "Label": "src/components/ui/label.tsx",
    "Select": "src/components/ui/select.tsx",
    "Separator": "src/components/ui/separator.tsx",
    "Sheet": "src/components/ui/sheet.tsx",
    "Skeleton": "src/components/ui/skeleton.tsx",
    "Spinner": "src/components/ui/spinner.tsx",
    "Switch": "src/components/ui/switch.tsx",
    "Tooltip": "src/components/ui/tooltip.tsx",
    "PageHeader": "src/components/page-header.tsx",
    "StatCard": "src/components/stat-card.tsx"
  }
}
